# HTML：让边缘缓存一段时间，但浏览器可快速校验更新
/*
  Cache-Control: public, max-age=0, s-maxage=7200, must-revalidate

# 指纹静态资源：强缓存一年（更推荐你让 Hexo 产物带 hash 文件名）
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable
